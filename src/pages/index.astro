---
const experience = [
  {
    years: '2020 — NOW',
    company: 'Netflix',
    role: 'Senior Test Lead · Growth, Partnerships & Payments',
    intro: 'I help teams turn complex, high-visibility launches into dependable customer experiences across markets, devices, and partner ecosystems.',
    details: [
      'Lead quality and delivery across growth, retention, acquisition, partnerships, payments, and global market initiatives.',
      'Partner across product, design, data science, content, infrastructure, and engineering—sometimes coordinating work across 15 teams.',
      'Shape test strategy for web, mobile, TV, APIs, experiments, and end-to-end customer journeys; surface risk and release signals early.',
      'Build and apply AI workflows, AI-assisted testing approaches, and team-level plugins to improve how engineering teams work.',
      'Serve as a project and engineering lead: clarify scope, align partners, unblock execution, and keep customer outcomes in view.'
    ],
    tags: ['AI workflows', 'A/B experimentation', 'Web · Mobile · TV', 'Cross-functional delivery']
  },
  {
    years: '2018 — 2020',
    company: 'Netflix',
    role: 'Quality Engineering · Growth & Membership Messaging',
    intro: 'Joined as the first QA engineer on the team and helped establish the testing approach for messaging experiences.',
    details: [
      'Built a quality strategy for outbound and in-product messaging across email, push, SMS, voice, messaging apps, and notifications.',
      'Designed experiment coverage across audience, design, copy, timing, frequency, and channel.',
      'Created automation and investigated issues spanning interconnected systems and devices.'
    ],
    tags: ['Foundational quality practices', 'Messaging systems', 'Experimentation']
  },
  {
    years: '2014 — 2018',
    company: 'Amazon',
    role: 'Quality Engineering · Growth, Acquisition & Subscriptions',
    intro: 'Combined hands-on engineering with Scrum leadership to help growth teams move from requirements to reliable releases.',
    details: [
      'Led sprint planning and delivery as Scrum Master while reviewing requirements, product specifications, and technical designs.',
      'Built and maintained Selenium and JavaScript automation for web and messaging experiences.',
      'Tested end-to-end journeys, APIs, backend and middleware integrations, and A/B experiments; supported CI/CD and release management.'
    ],
    tags: ['Selenium', 'JavaScript', 'Scrum', 'Jenkins']
  },
  {
    years: '2011 — 2014',
    company: 'Apple',
    role: 'Engineering Manager',
    intro: 'Led people, delivery, and quality across multiple enterprise and manufacturing initiatives.',
    details: [
      'Managed and mentored teams across 10+ projects, supporting delivery, performance, and team development.',
      'Partnered with engineering, product, and client stakeholders to clarify scope, risks, feasibility, and execution plans.',
      'Built strong operating practices for quality, delivery, collaboration, and continuous improvement.'
    ],
    tags: ['People leadership', 'Delivery management', 'Software excellence']
  },
  {
    years: '2004 — 2011',
    company: 'Wipro Technologies',
    role: 'QA Lead · Project Captain · Test Engineer',
    intro: 'Built a broad engineering foundation across banking, insurance, SAP CRM, and B2B commerce in India, Japan, and the United States.',
    details: [
      'Led system integration and end-to-end testing for B2B e-commerce and enterprise applications.',
      'Worked across SAP CRM, sales force automation, retail quote management, identity management, web, mobile, and automated testing.',
      'Partnered directly with clients on status, work breakdowns, feasibility, feature suggestions, and delivery.'
    ],
    tags: ['Enterprise systems', 'Client partnership', 'Test engineering']
  }
];

const capabilities = [
  ['Forward deployed mindset', 'Get close to the user and operating context, translate ambiguous needs into shipped work, and stay accountable through rollout.'],
  ['Engineering quality', 'Build risk-based strategies, automation, observability, and release practices into the delivery system.'],
  ['AI in the workflow', 'Apply AI to testing and daily engineering work, including workflow experiments and team-level plugins.'],
  ['Technical leadership', 'Align product, design, data, and engineering partners; coach teams and create clarity across complex programs.']
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ef" />
    <meta name="description" content="Roopa Iyer is an engineering and quality leader with 22 years of experience building better ways for teams to ship software." />
    <title>Roopa Iyer — Engineering, quality & delivery</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root{--paper:#fbfaf7;--ink:#12201e;--muted:#465750;--line:#c5cec7;--green:#b7f24d;--mint:#e2f2d8;--orange:#b8462c;--mono:'DM Mono',monospace;--sans:'DM Sans',sans-serif;--display:'Manrope',sans-serif}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 var(--sans)}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible{outline:3px solid var(--orange);outline-offset:4px}.wrap{width:min(1100px,calc(100% - 48px));margin-inline:auto}.topbar{display:flex;align-items:center;justify-content:space-between;padding:23px 0;border-bottom:1px solid var(--line);font-size:13px}.brand{font:700 14px var(--display);letter-spacing:-.03em}.nav{display:flex;gap:25px;color:var(--muted)}.nav a:hover{color:var(--ink)}.availability{font:11px var(--mono);text-transform:uppercase;letter-spacing:.06em}.availability:before{content:'';display:inline-block;width:8px;height:8px;border-radius:50%;background:#397a32;margin-right:8px;animation:pulse 2.2s ease-in-out infinite}.hero{padding:88px 0 83px;display:grid;grid-template-columns:1fr 270px;gap:50px;align-items:end;position:relative;isolation:isolate;overflow:hidden}.hero:before,.hero:after{content:'';position:absolute;z-index:-1;border-radius:50%;filter:blur(1px);opacity:.55;pointer-events:none}.hero:before{width:150px;height:150px;background:var(--green);right:18%;top:12%;animation:float 7s ease-in-out infinite}.hero:after{width:90px;height:90px;background:#f3b39b;right:8%;bottom:16%;animation:float 5s ease-in-out infinite reverse}.eyebrow,.section-kicker,.date,.label{font:11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}h1,h2,h3,p{margin-top:0}.hero h1{font:600 clamp(46px,7.5vw,92px)/1.08 var(--display);letter-spacing:-.075em;max-width:820px;margin:20px 0 25px}.hero h1 span{display:inline;background:var(--green);padding:0 .1em .08em;box-decoration-break:clone;-webkit-box-decoration-break:clone}.lede{max-width:650px;font-size:19px;line-height:1.6;color:var(--muted)}.lede strong{color:var(--ink);font-weight:600}.hero-side{border-left:1px solid var(--line);padding-left:25px;color:var(--muted);font-size:13px}.hero-side strong{display:block;font:700 28px var(--display);letter-spacing:-.06em;color:var(--ink);margin:7px 0 2px}.buttons{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:center;gap:12px;border:1px solid var(--ink);border-radius:3px;padding:11px 16px;font:600 13px var(--sans);cursor:pointer;background:transparent;color:var(--ink);min-height:44px;transition:transform .2s ease,background .2s ease}.button.primary{background:var(--ink);color:white}.button:hover{transform:translateY(-3px);background:var(--green);color:var(--ink)}.button.primary:hover{background:var(--orange);color:white}.manifesto{background:var(--ink);color:var(--paper);padding:66px 0}.manifesto-grid{display:grid;grid-template-columns:200px 1fr;gap:40px}.manifesto .section-kicker{color:#d5ded7}.manifesto h2{font:500 clamp(25px,4vw,42px)/1.2 var(--display);letter-spacing:-.05em;max-width:780px;margin:0}.manifesto h2 em{font-style:normal;color:var(--green)}.capabilities{padding:82px 0 64px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:30px}.section-head h2{font:600 34px var(--display);letter-spacing:-.06em;margin:8px 0 0}.section-head p{color:var(--muted);max-width:430px;margin:0;font-size:14px}.cap-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.cap{padding:23px 20px 24px 0}.cap+.cap{border-left:1px solid var(--line);padding-left:20px}.cap .num{font:11px var(--mono);color:var(--orange)}.cap h3{font:700 16px var(--display);letter-spacing:-.035em;margin:14px 0 8px}.cap p{font-size:13px;color:var(--muted);margin:0;line-height:1.6}.work{padding:65px 0 95px}.timeline{border-top:1px solid var(--line)}.job{display:grid;grid-template-columns:170px 1fr;gap:50px;padding:36px 0;border-bottom:1px solid var(--line);transition:transform .2s ease,padding-left .2s ease}.job:hover{transform:translateX(6px);padding-left:8px}.date{padding-top:7px}.job-head{display:flex;align-items:baseline;gap:15px;flex-wrap:wrap}.job h3{font:700 28px var(--display);letter-spacing:-.06em;margin:0}.role{font-size:13px;color:var(--muted)}.job-intro{font-size:16px;max-width:680px;margin:10px 0 17px;color:var(--muted)}.job ul{padding-left:18px;max-width:790px;margin:0}.job li{padding:3px 0 3px 4px;color:var(--ink);font-size:14px}.job li::marker{color:var(--orange)}.tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.tag{border:1px solid var(--line);border-radius:30px;padding:3px 9px;font:10px var(--mono);color:var(--muted)}.foundation{padding:18px 0 80px}.foundation-card{background:var(--mint);padding:35px 40px;display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:center}.foundation-card h2{font:600 27px var(--display);letter-spacing:-.06em;margin:8px 0}.foundation-card p{color:var(--muted);margin:0;font-size:14px}.foundation-facts{display:grid;grid-template-columns:1fr 1fr;gap:17px}.fact{border-top:1px solid #a7b9a4;padding-top:10px}.fact strong{display:block;font:600 15px var(--display)}.fact span{font-size:12px;color:var(--muted)}.contact{background:var(--green);padding:58px 0}.contact-inner{display:flex;align-items:center;justify-content:space-between;gap:25px}.contact h2{font:600 clamp(30px,5vw,54px)/1.08 var(--display);letter-spacing:-.07em;max-width:660px;margin:5px 0 0}.contact .button{border-color:var(--ink);white-space:nowrap}.footer{padding:20px 0;display:flex;justify-content:space-between;color:var(--muted);font-size:12px}.footer-links{display:flex;gap:18px}.footer a:hover{color:var(--ink)}
      @media(max-width:760px){.nav{display:none}.wrap{width:min(100% - 32px,1100px)}.hero{grid-template-columns:1fr;gap:28px;padding:56px 0}.hero h1{font-size:clamp(44px,13vw,70px)}.hero-side{border-left:0;border-top:1px solid var(--line);padding:18px 0 0}.manifesto-grid{grid-template-columns:1fr;gap:18px}.cap-grid{grid-template-columns:1fr}.cap,.cap+.cap{border-left:0;padding:20px 0}.cap+.cap{border-top:1px solid var(--line)}.job{grid-template-columns:1fr;gap:8px;padding:26px 0}.foundation-card{grid-template-columns:1fr;padding:27px 22px;gap:25px}.foundation-facts{grid-template-columns:1fr}.contact-inner{align-items:flex-start;flex-direction:column}.contact .button{white-space:normal}.footer{align-items:flex-start;gap:15px;flex-direction:column}.footer-links{flex-wrap:wrap}}
      @keyframes float{0%,100%{transform:translate3d(0,0,0) rotate(0deg)}50%{transform:translate3d(-12px,14px,0) rotate(8deg)}}@keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.4);opacity:.6}}
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.button,.job{transition:none}.button:hover,.job:hover{transform:none}.hero:before,.hero:after,.availability:before{animation:none}}
      @media print{body{background:white}.topbar,.buttons,.contact,.footer-links{display:none}.hero{padding:35px 0}.manifesto{padding:28px 0}.capabilities,.work{padding:35px 0}.job{break-inside:avoid}.wrap{width:100%}}
    </style>
  </head>
  <body>
    <header class="wrap topbar">
      <a class="brand" href="#top">ROOPA IYER<span style="color:var(--orange)">.</span></a>
      <nav class="nav" aria-label="Main navigation"><a href="#approach">Approach</a><a href="#work">Experience</a><a href="#contact">Contact</a></nav>
      <span class="availability">Engineering · Quality · AI</span>
    </header>
    <main id="top">
      <section class="wrap hero">
        <div>
          <div class="eyebrow">Building better ways to ship software</div>
          <h1>I lead teams that build<br /><span>and ship software people trust.</span></h1>
          <p class="lede">I’m Roopa, an engineering and quality leader who works across <strong>product, people, and code</strong> to solve real customer problems—from early discovery through launch and learning.</p>
          <div class="buttons"><a class="button primary" href="#work">Explore my work <span aria-hidden="true">↘</span></a><a class="button" href="https://www.linkedin.com/in/roopaiyer">Connect on LinkedIn <span aria-hidden="true">↗</span></a><button class="button" type="button" onclick="window.print()">Print / save as PDF</button></div>
        </div>
        <aside class="hero-side"><span class="label">My through line</span><strong>Find the friction.</strong>Bring the right people together, make risk visible, and improve the path from idea to a dependable release.</aside>
      </section>
      <section class="manifesto" id="approach"><div class="wrap manifesto-grid"><div class="section-kicker">HOW I WORK</div><h2>Quality is a team capability. I build the <em>habits, tools, and feedback loops</em> that help teams learn quickly and deliver experiences people can trust.</h2></div></section>
      <section class="wrap capabilities"><div class="section-head"><div><div class="section-kicker">WHERE I ADD VALUE</div><h2>From ambiguity to impact.</h2></div><p>My work sits at the intersection of customer context, technical execution, and software excellence.</p></div><div class="cap-grid">{capabilities.map(([title, description], i) => <article class="cap"><span class="num">0{i + 1}</span><h3>{title}</h3><p>{description}</p></article>)}</div></section>
      <section class="wrap work" id="work"><div class="section-head"><div><div class="section-kicker">THE JOURNEY</div><h2>Experience built across the stack.</h2></div><p>From hands-on enterprise testing to leading global product programs and enabling engineering teams.</p></div><div class="timeline">{experience.map((job) => <article class="job"><div class="date">{job.years}</div><div><div class="job-head"><h3>{job.company}</h3><span class="role">{job.role}</span></div><p class="job-intro">{job.intro}</p><ul>{job.details.map((item) => <li>{item}</li>)}</ul><div class="tags">{job.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div></article>)}</div></section>
      <section class="wrap foundation"><div class="foundation-card"><div><div class="section-kicker">THE FOUNDATION</div><h2>A broad engineering lens.</h2><p>My career has taken me through streaming, growth, payments, messaging, manufacturing, finance, supply chain, and retail. That range helps me ask better questions and adapt to the constraints of the system in front of me.</p></div><div class="foundation-facts"><div class="fact"><strong>People leadership</strong><span>Managed and mentored teams, including a 17-person team</span></div><div class="fact"><strong>Global collaboration</strong><span>Partners and customers across India, Japan, and the US</span></div><div class="fact"><strong>Engineering toolkit</strong><span>JavaScript, Selenium, APIs, SQL, CI/CD, data analysis</span></div><div class="fact"><strong>Education</strong><span>MS, Software Engineering · BITS Pilani</span></div></div></div></section>
      <section class="contact" id="contact"><div class="wrap contact-inner"><div><div class="section-kicker">LET’S BUILD SOMETHING THAT WORKS</div><h2>Good engineering starts with a useful conversation.</h2></div><a class="button" href="mailto:roops.iyer@gmail.com">Email Roopa <span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="wrap footer"><span>© {new Date().getFullYear()} Roopa Iyer</span><div class="footer-links"><a href="https://www.linkedin.com/in/roopaiyer">LinkedIn ↗</a><a href="mailto:roops.iyer@gmail.com">Email ↗</a><a href="#top">Back to top ↑</a></div></footer>
  </body>
</html>
