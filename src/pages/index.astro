      @media print{body{font-size:11px;line-height:1.4}.hero{padding:20px 0}.hero h1{font-size:28px;margin:10px 0 12px}.lede{font-size:12px}.manifesto{padding:18px 0 10px}.manifesto h2{font-size:22px}.fde{padding:18px 0 10px}.fde-copy h2{font-size:24px}.fde-card{padding:12px;min-height:0}.fde-card h3{font-size:14px}.fde-card p,.job li,.section-head p,.foundation-card p,.foundation-card .fact span{font-size:10px}.capabilities,.work{padding:18px 0}.section-head h2{font-size:22px}.job{padding:18px 0;gap:20px}.job h3{font-size:20px}.job-intro{font-size:11px;margin:5px 0 8px}.volunteering,.strengths,.foundation{padding:12px 0 18px}.volunteer-card{padding:14px}.volunteer-card h3{font-size:20px}.contact{display:none}.footer{padding:10px 0}.strength{font-size:9px;padding:5px 7px}}
      .scroll-reveal{content-visibility:auto;contain-intrinsic-size:360px;opacity:0;transform:translateY(18px);transition:opacity .55s ease,transform .55s ease}.scroll-reveal.is-visible{opacity:1;transform:none}@media(prefers-reduced-motion:reduce){.scroll-reveal{opacity:1;transform:none;transition:none}}
    </style>
