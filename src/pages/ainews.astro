---
import edition from '../data/ainews-latest.json';

const dateLabel = new Date(`${edition.editionDate}T12:00:00`).toLocaleDateString('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: edition.timezone
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f7fb" />
    <meta name="description" content="A sourced, witty morning newspaper about AI: news, a concept to learn, and what to focus on today." />
    <title>The Daily AI Gazette · Roopa Iyer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root{--paper:#f4f7fb;--ink:#12243a;--muted:#4b6174;--line:#c5d1dc;--accent:#d95b3f;--soft:#e4eef5;--mono:'DM Mono',monospace;--sans:'DM Sans',sans-serif;--display:'Manrope',sans-serif}
      *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 var(--sans)}a{color:inherit}a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.wrap{width:min(1040px,calc(100% - 44px));margin:auto}
      .top{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:18px 0;border-bottom:2px solid var(--ink)}.brand{font:700 26px var(--mono);letter-spacing:-.08em;text-decoration:none}.nav{display:flex;gap:20px;font-size:12px;text-transform:uppercase;letter-spacing:.06em}.nav a{text-decoration:none}.nav a:hover{text-decoration:underline;text-decoration-color:var(--accent);text-underline-offset:5px}
      .masthead{text-align:center;padding:54px 0 28px;border-bottom:1px solid var(--line)}.kicker,.meta,.label{font:11px var(--mono);letter-spacing:.13em;text-transform:uppercase;color:var(--accent)}h1{font:800 clamp(42px,8vw,88px)/.95 var(--display);letter-spacing:-.085em;margin:15px 0 10px}.dek{font-size:17px;color:var(--muted);margin:0 auto;max-width:620px}.edition-meta{display:flex;justify-content:center;gap:12px 24px;flex-wrap:wrap;margin-top:23px;font:11px var(--mono);text-transform:uppercase;color:var(--muted)}
      .front{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,.8fr);gap:30px;padding:35px 0;border-bottom:1px solid var(--line)}.lead{padding:26px 30px;background:var(--ink);color:#fff;border-radius:3px}.lead .label{color:#ffb5a2}.lead h2{font:700 clamp(28px,4vw,42px)/1.08 var(--display);letter-spacing:-.055em;margin:12px 0}.lead p{color:#e5edf3}.lead .why{border-top:1px solid #526174;padding-top:13px;margin-top:16px}.sources{font:11px var(--mono);display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.sources a{color:inherit;text-underline-offset:3px}.sidebox{border-top:3px solid var(--ink);border-bottom:1px solid var(--line);padding:17px 0}.sidebox h2{font:700 22px var(--display);letter-spacing:-.04em;margin:5px 0 10px}.sidebox p{color:var(--muted);margin:0}
      .section{padding:38px 0;border-bottom:1px solid var(--line)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:19px}.section-head h2{font:700 30px var(--display);letter-spacing:-.06em;margin:3px 0 0}.section-head p{font-size:12px;color:var(--muted);margin:0}.story{display:grid;grid-template-columns:42px 1fr;gap:16px;padding:20px 0;border-top:1px solid var(--line)}.story-num{font:16px var(--mono);color:var(--accent)}.story h3{font:700 23px/1.2 var(--display);letter-spacing:-.04em;margin:2px 0 6px}.story p{margin:0 0 10px;color:var(--muted)}.story .why{color:var(--ink);font-size:14px}.card{border:1px solid var(--line);padding:25px 27px;background:rgba(255,255,255,.46);border-radius:3px}.card h3{font:700 24px var(--display);letter-spacing:-.04em;margin:5px 0 9px}.card p{color:var(--muted)}.exercise{background:var(--soft);padding:13px 15px;margin-top:15px;border-left:3px solid var(--accent)}.focus-list{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.focus-card{padding:18px;border-top:3px solid var(--accent);background:rgba(255,255,255,.5)}.focus-card p{margin:8px 0 0;font-size:14px}.note-list{padding-left:18px;color:var(--muted);font-size:13px}.note-list li{padding:4px 0}.footer{padding:22px 0 34px;color:var(--muted);font-size:12px;display:flex;justify-content:space-between;gap:16px}.footer a{text-underline-offset:3px}
      @media(max-width:700px){.wrap{width:min(100% - 28px,1040px)}.top{flex-wrap:wrap}.brand{font-size:23px}.nav{gap:15px}.masthead{padding:40px 0 24px}.front{grid-template-columns:1fr;gap:20px}.lead{padding:23px}.focus-list{grid-template-columns:1fr}.section-head{display:block}.section-head p{margin-top:6px}.story{grid-template-columns:28px 1fr;gap:10px}.footer{flex-direction:column}}
    </style>
  </head>
  <body>
    <header class="wrap top">
      <a class="brand" href="/">ROOPA IYER</a>
      <nav class="nav" aria-label="Main navigation"><a href="/">Portfolio</a><a href="#learn">Learn</a><a href="#focus">Focus today</a></nav>
    </header>
    <main class="wrap">
      <header class="masthead">
        <div class="kicker">A daily newspaper for the AI curious</div>
        <h1>The Daily<br />AI Gazette</h1>
        <p class="dek">The important AI developments found so far. The headlines may smirk; the sourcing does not.</p>
        <div class="edition-meta"><span>{dateLabel}</span><span>{edition.cutoff}</span><span>{edition.editionLabel}</span></div>
      </header>
      <section class="front" aria-label="Front page">
        <article class="lead">
          <div class="label">Front page · {edition.lead.status}</div>
          <h2>{edition.lead.title}</h2>
          <p>{edition.lead.summary}</p>
          <p class="why"><strong>Why you should care:</strong> {edition.lead.whyCare}</p>
          <div class="sources">{edition.lead.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div>
        </article>
        <aside class="sidebox">
          <div class="label">Learn one thing</div>
          <h2>{edition.learning.title}</h2>
          <p>{edition.learning.body}</p>
          <div class="sources"><a href="#learn">Try the mini exercise ↓</a></div>
        </aside>
      </section>
      <section class="section" aria-labelledby="news-heading">
        <div class="section-head"><div><div class="label">The news desk</div><h2 id="news-heading">Today’s developments</h2></div><p>Grouped by story. Sources linked below each item.</p></div>
        {edition.news.map((story, index) => <article class="story"><div class="story-num">{String(index + 1).padStart(2, '0')}</div><div><div class="meta">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><p class="why"><strong>Why it matters:</strong> {story.whyCare}</p><div class="sources">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></div></article>)}
      </section>
      <section class="section" id="learn" aria-labelledby="learn-heading">
        <div class="section-head"><div><div class="label">A useful idea, in plain English</div><h2 id="learn-heading">Learn one thing</h2></div></div>
        <article class="card"><h3>{edition.learning.title}</h3><p>{edition.learning.body}</p><div class="exercise"><strong>Try this:</strong> {edition.learning.tryThis}</div></article>
      </section>
      <section class="section" id="focus" aria-labelledby="focus-heading">
        <div class="section-head"><div><div class="label">Three things to carry into the day</div><h2 id="focus-heading">Your focus today</h2></div></div>
        <div class="focus-list">{edition.focus.map((item) => <article class="focus-card"><div class="label">{item.kind}</div><p>{item.text}</p></article>)}</div>
      </section>
      <section class="section" aria-labelledby="notes-heading">
        <div class="section-head"><div><div class="label">The margin notes</div><h2 id="notes-heading">What to keep in mind</h2></div></div>
        <ul class="note-list">{edition.notes.map((note) => <li>{note}</li>)}</ul>
      </section>
      <footer class="footer"><span>Compiled in {edition.timezone}. A curated briefing, not every article on the internet.</span><a href="/">Back to Roopa’s portfolio ↑</a></footer>
    </main>
  </body>
</html>
