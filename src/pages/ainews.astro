---
import edition from '../data/ainews-latest.json';

const dateLabel = new Date(`${edition.editionDate}T12:00:00`).toLocaleDateString('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: edition.timezone
});
const critical = edition.critical ?? [edition.lead, ...(edition.news ?? [])].filter(Boolean);
const giggles = edition.giggles ?? [];
const incidents = edition.incidents ?? [];
const launches = edition.launches ?? [];
const research = edition.research ?? [];
const signals = edition.signals ?? [];
const briefs = edition.briefs ?? [];
const insights = edition.insights ?? (edition.focus ?? []).map((item) => ({
  priority: item.kind, title: item.kind, context: 'The earlier edition did not include context for this focus item.',
  whyItMatters: item.text, action: item.text, watchFor: '', sources: []
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3efe5" />
    <meta name="description" content="AI News: a newspaper-style daily briefing with critical developments, AI giggles, incident reports, and actionable insights." />
    <title>AI News · The Daily Brief</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root{--paper:#f3efe5;--sheet:#fbf9f2;--ink:#201d19;--muted:#625d54;--line:#b8b0a1;--red:#a43124;--gold:#d5a62e;--sage:#dfe6d6;--mono:'DM Mono',monospace;--sans:'DM Sans',Arial,sans-serif;--serif:'Playfair Display',Georgia,serif}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.62 var(--sans)}a{color:inherit}a:focus-visible{outline:3px solid var(--red);outline-offset:3px}.sheet{width:min(1140px,calc(100% - 40px));margin:auto;background:var(--sheet);padding:0 42px 34px;box-shadow:0 0 32px rgba(40,33,23,.06)}
      .utility{display:flex;justify-content:space-between;gap:14px;padding:10px 0;border-bottom:1px solid var(--line);font:10px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.utility nav{display:flex;gap:16px;flex-wrap:wrap}.utility a{text-decoration:none}.utility a:hover{color:var(--red);text-decoration:underline;text-underline-offset:4px}
      .masthead{text-align:center;padding:27px 0 20px;border-bottom:5px double var(--ink)}.overline,.meta,.label,.stamp{font:10px var(--mono);letter-spacing:.13em;text-transform:uppercase;color:var(--red)}h1{font:800 clamp(45px,8vw,94px)/.94 var(--serif);letter-spacing:-.065em;margin:6px 0 8px}.subtitle{font:italic 16px var(--serif);color:var(--muted);margin:0 auto;max-width:720px}.editionline{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:19px;padding:7px 0;border-top:1px solid var(--line);font:10px var(--mono);letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
      .front-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(245px,.8fr);gap:25px;padding:24px 0;border-bottom:2px solid var(--ink)}.lead{padding:0 24px 6px 0;border-right:1px solid var(--line)}.lead h2{font:700 clamp(30px,4.5vw,52px)/1.08 var(--serif);letter-spacing:-.045em;margin:8px 0 11px}.lead p{margin:7px 0;color:var(--muted)}.lead .why{color:var(--ink);border-left:3px solid var(--red);padding:3px 0 3px 12px;margin:14px 0}.side-digest{padding:0 3px}.side-digest h2{font:700 21px/1.2 var(--serif);margin:6px 0 13px}.digest-item{padding:11px 0;border-top:1px solid var(--line)}.digest-item p{margin:4px 0 0;color:var(--muted);font-size:13px}.source-links{display:flex;gap:7px 14px;flex-wrap:wrap;margin-top:10px;font:10px var(--mono)}.source-links a{text-decoration:underline;text-underline-offset:3px}.section{padding:24px 0 27px;border-bottom:1px solid var(--ink)}.section-title{display:flex;align-items:baseline;justify-content:space-between;gap:15px;padding-bottom:9px;border-bottom:3px solid var(--ink);margin-bottom:12px}.section-title h2{font:700 clamp(24px,3vw,34px)/1.1 var(--serif);letter-spacing:-.04em;margin:0}.section-title p{font:11px var(--mono);color:var(--muted);margin:0;text-align:right}.flag{font:10px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--red)}
      .critical-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px}.story{padding:13px 0 15px;border-bottom:1px solid var(--line)}.story h3{font:700 22px/1.2 var(--serif);letter-spacing:-.025em;margin:5px 0}.story p{margin:6px 0;color:var(--muted);font-size:14px}.story .context{color:var(--ink)}.story .why{padding-left:11px;border-left:2px solid var(--red)}.story .publisher{font:10px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
      .desk{display:grid;grid-template-columns:1fr 1fr;gap:22px}.desk-panel{padding:17px 18px 20px;background:#f5f0e4;border-top:4px solid var(--gold)}.desk-panel.incidents{background:#f4e9e3;border-color:var(--red)}.desk-panel .section-title{display:block;margin-bottom:8px}.desk-panel .section-title h2{margin:2px 0}.desk-panel .story{border-bottom-color:#cfc5b4}.desk-panel .empty{font:italic 16px/1.55 var(--serif);color:var(--muted);padding:12px 0}.desk-panel .empty strong{color:var(--ink)}
      .wire-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 22px}.wire-card{padding:12px 14px;background:#fffdf8;border:1px solid var(--line);margin:0 0 12px}.wire-card h3{font:700 19px/1.2 var(--serif);margin:5px 0}.wire-card p{font-size:13px;color:var(--muted);margin:6px 0}.wire-card .publisher{font:10px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}.wire-desk{margin:17px 0}.wire-desk h3{font:700 25px var(--serif);margin:0 0 8px;border-bottom:2px solid var(--ink);padding-bottom:6px}.wire-grid.compact{grid-template-columns:repeat(4,minmax(0,1fr))}.insights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.insight{padding:16px 16px 18px;border:1px solid var(--line);background:#fffdf8}.insight-top{display:flex;justify-content:space-between;gap:10px;align-items:center}.priority{font:10px var(--mono);text-transform:uppercase;letter-spacing:.1em;background:var(--sage);padding:4px 7px}.insight h3{font:700 20px/1.2 var(--serif);margin:10px 0 7px}.insight p{margin:7px 0;color:var(--muted);font-size:13px}.insight p strong{color:var(--ink)}.insight .source-links{margin-top:12px}
      .learning{display:grid;grid-template-columns:.7fr 1.3fr;gap:20px;align-items:start}.learning h3{font:700 26px var(--serif);margin:4px 0}.learning p{margin:5px 0;color:var(--muted)}.try{padding:13px 15px;background:var(--sage);border-left:3px solid #62794d;color:var(--ink)!important}
      .note-list{padding-left:18px;color:var(--muted);font-size:12px}.note-list li{padding:3px 0}.footer{display:flex;justify-content:space-between;gap:14px;padding:17px 0 0;font:10px var(--mono);color:var(--muted)}.footer a{text-underline-offset:3px}
      @media(max-width:760px){.sheet{width:100%;padding:0 19px 26px;box-shadow:none}.utility{align-items:flex-start;flex-direction:column}.utility nav{gap:13px}.masthead{padding-top:24px}.editionline{align-items:flex-start;flex-direction:column;gap:4px}.front-grid{grid-template-columns:1fr;gap:16px}.lead{border-right:0;border-bottom:1px solid var(--line);padding:0 0 17px}.critical-grid,.desk,.wire-grid,.wire-grid.compact,.insights,.learning{grid-template-columns:1fr}.section-title{align-items:flex-start;flex-direction:column;gap:3px}.section-title p{text-align:left}.footer{flex-direction:column}.story h3{font-size:21px}}
      @media print{body{background:#fff}.sheet{width:100%;box-shadow:none;padding:0 18px}.utility nav{display:none}.section,.front-grid{break-inside:avoid}.lead{padding-left:0}.masthead{padding-top:10px}.section{padding:15px 0}}
    </style>
  </head>
  <body>
    <main class="sheet">
      <header class="utility">
        <span>AI News · Independent daily briefing</span>
        <nav aria-label="Edition sections"><a href="#critical">Critical</a><a href="#giggles">AI Giggles</a>{incidents.length > 0 && <a href="#incidents">Incident desk</a>}<a href="#newsroom">Newsroom</a><a href="#insights">Actionable insights</a></nav>
      </header>
      <header class="masthead">
        <div class="overline">The daily artificial intelligence briefing</div>
        <h1>AI News</h1>
        <p class="subtitle">The day’s consequential developments, curious moments, failures, and useful next steps. A little wit in the margins; receipts in every column.</p>
        <div class="editionline"><span>{dateLabel} · {edition.cutoff}</span><span>{edition.editionLabel}</span><span>{edition.timezone}</span></div>
      </header>
      <section class="front-grid" aria-label="Front page">
        <article class="lead">
          <div class="flag">Lead story · {edition.lead.status}</div>
          <h2>{edition.lead.title}</h2>
          <p>{edition.lead.summary}</p>
          <p class="why"><strong>Why it matters:</strong> {edition.lead.whyCare}</p>
          <div class="source-links">{edition.lead.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div>
        </article>
        <aside class="side-digest">
          <div class="label">The day in brief</div>
          <h2>What made the front page</h2>
          {critical.slice(0, 3).map((story, index) => <article class="digest-item"><div class="publisher">{String(index + 1).padStart(2, '0')} · {story.status}</div><p><a href="#critical">{story.title}</a></p></article>)}
        </aside>
      </section>
      <section class="section" id="critical" aria-labelledby="critical-heading">
        <div class="section-title"><div><div class="flag">Front page · high impact</div><h2 id="critical-heading">Important &amp; critical</h2></div><p>What could change decisions, risk, or direction?</p></div>
        <div class="critical-grid">
          {critical.map((story, index) => <article class="story"><div class="publisher">No. {String(index + 1).padStart(2, '0')} · {story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><p class="why"><strong>Why it matters:</strong> {story.whyCare}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}
        </div>
      </section>
      {(launches.length > 0 || research.length > 0 || signals.length > 0 || briefs.length > 0) && <section class="section" id="newsroom" aria-labelledby="newsroom-heading">
        <div class="section-title"><div><div class="flag">More from the wire</div><h2 id="newsroom-heading">The newsroom</h2></div><p>Products, research, business, policy, and the signals worth a second look.</p></div>
        {launches.length > 0 && <div class="wire-desk"><h3>Launchpad</h3><div class="wire-grid">{launches.map((story) => <article class="wire-card"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}</div></div>}
        {research.length > 0 && <div class="wire-desk"><h3>Research &amp; benchmarks</h3><div class="wire-grid">{research.map((story) => <article class="wire-card"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}</div></div>}
        {signals.length > 0 && <div class="wire-desk"><h3>Markets, policy &amp; work</h3><div class="wire-grid">{signals.map((story) => <article class="wire-card"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}</div></div>}
        {briefs.length > 0 && <div class="wire-desk"><h3>Briefing wire</h3><div class="wire-grid compact">{briefs.map((story) => <article class="wire-card"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}</div></div>}
      </section>}
      <section class="section" aria-label="AI Giggles{incidents.length ? ' and Incidents' : ''}">
        <div class="desk" style={incidents.length ? undefined : 'grid-template-columns:1fr'}>
          <section class="desk-panel" id="giggles" aria-labelledby="giggles-heading">
            <div class="section-title"><div><div class="flag">The lighter side</div><h2 id="giggles-heading">AI Giggles</h2></div><p>Odd, amusing, and sourceable.</p></div>
            {giggles.length ? giggles.map((story) => <article class="story"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><p class="context"><strong>Why it’s funny (and relevant):</strong> {story.whyCare}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>) : <p class="empty">No verifiable giggle made today’s wire by this edition’s cutoff. We’ll keep the jokes in the headlines, not in the facts.</p>}
          </section>
          {incidents.length > 0 && <section class="desk-panel incidents" id="incidents" aria-labelledby="incidents-heading">
            <div class="section-title"><div><div class="flag">Failures · accidents · harmful actions</div><h2 id="incidents-heading">Incident desk</h2></div><p>What went wrong, and what is confirmed?</p></div>
            {incidents.map((story) => <article class="story"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><p class="context"><strong>Impact / response:</strong> {story.whyCare}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}
          </section>}
        </div>
      </section>
      <section class="section" id="insights" aria-labelledby="insights-heading">
        <div class="section-title"><div><div class="flag">Context → decision → next move</div><h2 id="insights-heading">Actionable insights</h2></div><p>Every item says why it matters and what to do next.</p></div>
        <div class="insights">
          {insights.map((item) => <article class="insight"><div class="insight-top"><span class="priority">{item.priority}</span><span class="label">Focus brief</span></div><h3>{item.title}</h3><p><strong>Context:</strong> {item.context}</p><p><strong>Why focus:</strong> {item.whyItMatters}</p><p><strong>Action:</strong> {item.action}</p>{item.watchFor && <p><strong>Watch for:</strong> {item.watchFor}</p>}<div class="source-links">{item.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}
        </div>
      </section>
      <section class="section" id="learn" aria-labelledby="learn-heading">
        <div class="section-title"><div><div class="flag">A concept from the news</div><h2 id="learn-heading">Understand one thing</h2></div></div>
        <article class="learning"><div><div class="label">Today’s concept</div><h3>{edition.learning.title}</h3></div><div><p>{edition.learning.body}</p><p class="try"><strong>Try this:</strong> {edition.learning.tryThis}</p></div></article>
      </section>
      <section class="section" aria-labelledby="notes-heading">
        <div class="section-title"><div><div class="flag">Corrections &amp; caveats</div><h2 id="notes-heading">Editor’s notes</h2></div></div>
        <ul class="note-list">{edition.notes.map((note) => <li>{note}</li>)}</ul>
      </section>
      <footer class="footer"><span>Compiled through {edition.cutoff} · {edition.timezone}. Curated from sources searched; not an exhaustive index.</span><a href="/">← Portfolio</a></footer>
    </main>
  </body>
</html>
