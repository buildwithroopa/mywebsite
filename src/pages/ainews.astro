---
import edition from '../data/ainews-latest.json';

const dateLabel = new Date(`${edition.editionDate}T12:00:00`).toLocaleDateString('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: edition.timezone
});
const critical = edition.critical ?? [edition.lead, ...(edition.news ?? [])].filter(Boolean);
const giggles = edition.giggles ?? [];
const incidents = edition.incidents ?? [];
const launches = edition.launches ?? [];
const research = edition.research ?? [];
const signals = edition.signals ?? [];
const briefs = edition.briefs ?? [];
const takeaways = edition.takeaways ?? [];
const insights = edition.insights ?? (edition.focus ?? []).map((item) => ({
  priority: item.kind, title: item.kind, context: 'The earlier edition did not include context for this focus item.',
  whyItMatters: item.text, action: item.text, watchFor: '', sources: []
}));
const totalStories = critical.length + launches.length + research.length + signals.length + briefs.length + giggles.length + incidents.length;
const memes = [
  { image: '/images/ainews-meme-prompt.jpg', alt: 'A friendly AI robot makes a comically long scroll while an editor asks for a short answer.', topic: 'Prompting · Lesson 01', title: '“Keep it short,” said the prompt.', lesson: 'Specific constraints beat vague wishes. Name the audience, length, format, and an example to get a more useful first draft.' },
  { image: '/images/ainews-meme-approval.jpg', alt: 'A cheerful AI agent pauses at a large red button while a human editor gives approval behind a safety rail.', topic: 'AI agents · Lesson 02', title: 'The agent found the big red button.', lesson: 'Give agents only the access they need. Require human approval before payments, publishing, or deleting anything.' },
  { image: '/images/ainews-meme-benchmark.jpg', alt: 'A proud AI robot with a benchmark trophy compares its score with a researcher’s real-world task checklist.', topic: 'Evaluation · Lesson 03', title: 'First place on the benchmark. Now try Tuesday.', lesson: 'Benchmarks compare systems on a test set; your own task may differ. Evaluate with representative examples and human review.' }
];
const memeOffset = new Date(`${edition.editionDate}T12:00:00Z`).getUTCDate() % memes.length;
const dailyMeme = memes[memeOffset];
const showDailyMeme = totalStories < 16;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3efe5" />
    <meta name="description" content="AI News: a newspaper-style daily briefing with critical developments, AI giggles, incident reports, and actionable insights." />
    <title>AI News · The Daily Brief</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root{--paper:#ece7da;--sheet:#f8f5ed;--card:#fffdf7;--ink:#211e19;--muted:#625c52;--line:#c8bfaf;--red:#9e3025;--gold:#d6aa43;--sage:#e1e9d9;--mono:'DM Mono',monospace;--sans:'DM Sans',Arial,sans-serif;--serif:'Playfair Display',Georgia,serif}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 var(--sans)}a{color:inherit}a:focus-visible,button:focus-visible{outline:3px solid var(--red);outline-offset:3px}
      .sheet{width:min(1660px,calc(100% - 18px));margin:9px auto;background:var(--sheet);padding:0 16px 16px;box-shadow:0 5px 26px rgba(33,30,25,.09)}
      .utility{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:6px 0;border-bottom:1px solid var(--line);font:10px var(--mono);letter-spacing:.07em;text-transform:uppercase;color:var(--muted)}.utility nav{display:flex;gap:12px;flex-wrap:wrap}.utility a{text-decoration:none}.utility a:hover{color:var(--red);text-decoration:underline;text-underline-offset:3px}
      .masthead{text-align:center;padding:12px 0 9px;border-bottom:5px double var(--ink)}.overline,.meta,.label,.stamp,.flag{font:11px var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--red)}h1{font:800 clamp(50px,6vw,80px)/.9 var(--serif);letter-spacing:-.06em;margin:3px 0}.subtitle{font:italic 15px var(--serif);color:var(--muted);margin:0 auto;max-width:760px}.editionline{display:flex;justify-content:space-between;gap:10px;margin-top:9px;padding:6px 0 0;border-top:1px solid var(--line);font:12px var(--mono);letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
      .front-grid{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(260px,.85fr);gap:9px;padding:9px 0 5px}.lead,.side-digest,.digest-item,.section,.desk-panel,.idea-box,.story,.wire-card,.insight,.learning{background:var(--card);border:1px solid var(--line);box-shadow:0 2px 6px rgba(33,30,25,.045)}
      .lead{padding:12px 15px;border-top:5px solid var(--red)}.lead h2{font:700 clamp(33px,3.8vw,52px)/1.05 var(--serif);letter-spacing:-.04em;margin:5px 0 8px}.lead p{margin:6px 0;color:var(--muted)}.lead .why{color:var(--ink);border-left:3px solid var(--red);padding:2px 0 2px 9px}.side-digest{padding:10px;background:#f0ebdf}.side-digest h2{font:700 24px/1.1 var(--serif);margin:3px 0 8px}.digest-item{padding:7px;margin:5px 0;font-size:15px}.digest-item p{margin:3px 0 0}.source-links{display:flex;gap:5px 11px;flex-wrap:wrap;margin-top:auto;padding-top:8px;font:11px var(--mono)}.source-links a{text-decoration:underline;text-underline-offset:3px}.source-links a:hover{color:var(--red)}
      .section{padding:9px 10px 11px;margin:5px 0 9px;background:transparent;border:0;border-top:2px solid var(--ink);box-shadow:none}.section-title{display:flex;align-items:baseline;justify-content:space-between;gap:10px;padding-bottom:5px;margin-bottom:7px;border-bottom:1px solid var(--line)}.section-title h2{font:700 clamp(27px,3vw,38px)/1.05 var(--serif);letter-spacing:-.035em;margin:1px 0}.section-title p{font:13px var(--mono);color:var(--muted);margin:0;text-align:right}
      .critical-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.story{display:flex;flex-direction:column;min-width:0;padding:9px 10px;border-top:3px solid var(--line)}.story h3{font:700 20px/1.16 var(--serif);letter-spacing:-.02em;margin:5px 0}.story p{margin:4px 0;color:var(--muted);font-size:14px}.story .context,.story .why{color:var(--ink)}.story .why{padding-top:5px;border-top:1px dotted var(--line)}.story .publisher{font:11px var(--mono);letter-spacing:.055em;text-transform:uppercase;color:var(--muted)}
      .desk{display:grid;grid-template-columns:1fr 1fr;gap:9px}.desk-panel{padding:10px;background:#f3edde;border-top:4px solid var(--gold)}.desk-panel.incidents{background:#f5e9e3;border-top-color:var(--red)}.desk-panel .section-title{display:block;margin-bottom:6px}.desk-panel .section-title h2{margin:2px 0}.desk-panel .story{margin-top:6px}
      .wire-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.wire-card{display:flex;flex-direction:column;min-width:0;width:auto;margin:0;padding:9px;border-top:3px solid var(--line);break-inside:avoid}.wire-card h3{font:700 19px/1.16 var(--serif);margin:4px 0}.wire-card p{font-size:14px;color:var(--muted);margin:5px 0}.wire-card .publisher{font:11px var(--mono);letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}.wire-desk{margin:9px 0}.wire-desk>h3{font:700 19px var(--serif);margin:0 0 6px;padding-bottom:4px;border-bottom:1px solid var(--line)}.wire-grid.compact{grid-template-columns:repeat(5,minmax(0,1fr))}
      .insights{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.insight{padding:9px 10px;border-top:4px solid #74815f}.insight-top{display:flex;justify-content:space-between;gap:7px;align-items:center}.priority{font:11px var(--mono);text-transform:uppercase;letter-spacing:.08em;background:var(--sage);padding:3px 6px}.insight h3{font:700 19px/1.16 var(--serif);margin:6px 0 4px}.insight p{margin:4px 0;color:var(--muted);font-size:14px}.insight p strong{color:var(--ink)}
      .idea-box{display:grid;grid-template-columns:.7fr 1.3fr;gap:12px;padding:10px 12px;background:#f1ecdf;border-left:4px solid var(--gold)}.idea-box h3{font:700 24px/1.15 var(--serif);margin:0}.idea-box p{margin:0 0 5px;color:var(--muted);font-size:14px}.idea-box p strong{color:var(--ink)}.share-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.share-button{border:1px solid var(--ink);background:transparent;color:var(--ink);padding:5px 7px;margin-top:7px;font:11px var(--mono);text-transform:uppercase;cursor:pointer}.share-button:hover{background:var(--ink);color:var(--sheet)}
      .front-rail{display:grid;grid-template-rows:1fr auto;gap:7px;min-width:0}.meme-card{display:grid;grid-template-columns:112px 1fr;align-items:center;overflow:hidden;padding:0;background:var(--card);border:1px solid var(--line);border-top:3px solid var(--gold);min-width:0}.meme-card img{display:block;width:112px;height:100%;min-height:92px;max-height:120px;object-fit:cover;background:#eee7d8}.meme-copy{min-width:0;padding:7px 9px}.meme-copy h3{font:700 17px/1.12 var(--serif);margin:3px 0}.meme-copy p{font-size:12px;color:var(--muted);line-height:1.35;margin:3px 0}.daily-pick{display:inline-block;margin-bottom:2px;padding:2px 5px;background:var(--sage);font:8px var(--mono);letter-spacing:.07em;text-transform:uppercase}
      .learning{display:grid;grid-template-columns:.65fr 1.35fr;gap:12px;align-items:start;padding:10px 12px;background:var(--sage);border-left:4px solid #74815f}.learning h3{font:700 28px var(--serif);margin:3px 0}.learning p{margin:4px 0;color:var(--muted);font-size:14px}.try{padding:7px 9px;background:rgba(255,255,255,.55);border-left:3px solid #74815f;color:var(--ink)!important}
      .footer{display:flex;justify-content:space-between;gap:10px;padding:8px 0 0;border-top:2px solid var(--ink);font:11px var(--mono);color:var(--muted)}.footer a{text-underline-offset:3px}
      @media(max-width:1120px){.critical-grid,.wire-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.wire-grid.compact{grid-template-columns:repeat(4,minmax(0,1fr))}.insights{grid-template-columns:repeat(3,minmax(0,1fr))}}
      @media(max-width:820px){.sheet{width:100%;margin:0;padding:0 12px 15px;box-shadow:none}.utility{align-items:flex-start;flex-direction:column}.utility nav{gap:8px 11px}.masthead{padding-top:20px}.editionline{align-items:flex-start;flex-wrap:wrap}.front-grid{grid-template-columns:1fr}.critical-grid,.wire-grid,.wire-grid.compact,.share-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.desk{grid-template-columns:1fr}.insights{grid-template-columns:repeat(2,minmax(0,1fr))}.section-title{align-items:flex-start;flex-direction:column;gap:3px}.section-title p{text-align:left}}
      @media(max-width:520px){.critical-grid,.wire-grid,.wire-grid.compact,.share-cards,.insights{grid-template-columns:1fr}.idea-box,.learning{grid-template-columns:1fr;gap:5px}.footer{flex-direction:column}.story h3{font-size:21px}}
      @media print{body{background:#fff}.sheet{width:100%;margin:0;padding:0 10px;box-shadow:none}.utility nav,.share-button{display:none}.section,.front-grid{break-inside:avoid}.lead{padding-left:0}.masthead{padding-top:8px}.section{padding:8px 0}.story,.wire-card,.insight,.learning,.idea-box,.side-digest{box-shadow:none;break-inside:avoid}}
    </style>
  </head>
  <body>
    <main class="sheet">
      <header class="utility">
        <span>AI News · Independent daily briefing</span>
        <nav aria-label="Edition sections"><a href="#critical">Critical</a><a href="#one-idea">One idea</a><a href="#giggles">AI Giggles</a>{incidents.length > 0 && <a href="#incidents">Incident desk</a>}<a href="#newsroom">Newsroom</a><a href="#memes">Meme of the day</a><a href="#insights">Actionable insights</a><a href="#shareables">Takeaways</a><a href="/ainews/archive">Past editions</a></nav>
      </header>
      <header class="masthead">
        <div class="overline">The daily artificial intelligence briefing</div>
        <h1>AI News</h1>
        <p class="subtitle">The day’s consequential developments, curious moments, failures, and useful next steps. A little wit in the margins; receipts in every column.</p>
        <div class="editionline"><span>{dateLabel}</span></div>
      </header>
      <section class="front-grid" aria-label="Front page">
        <article class="lead">
          <div class="flag">Lead story · {edition.lead.status}</div>
          <h2>{edition.lead.title}</h2>
          <p>{edition.lead.summary}</p>
          <p class="why"><strong>Why it matters:</strong> {edition.lead.whyCare}</p>
          <div class="source-links">{edition.lead.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div>
        </article>
        <aside class="front-rail">
          <section class="side-digest">
            <div class="label">The day in brief</div>
            <h2>What made the front page</h2>
            {critical.slice(0, 3).map((story, index) => <article class="digest-item"><div class="publisher">{String(index + 1).padStart(2, '0')} · {story.status}</div><p><a href="#critical">{story.title}</a></p></article>)}
          </section>
          {showDailyMeme && <article class="meme-card" id="memes"><img src={dailyMeme.image} alt={dailyMeme.alt} loading="lazy" decoding="async" /><div class="meme-copy"><span class="daily-pick">AI meme · lesson</span><div class="publisher">{dailyMeme.topic}</div><h3>{dailyMeme.title}</h3><p>{dailyMeme.lesson}</p></div></article>}
        </aside>
      </section>
      <section class="section" id="one-idea" aria-labelledby="one-idea-heading">
        <div class="section-title"><div><div class="flag">Our read · built from today’s reporting</div><h2 id="one-idea-heading">One idea</h2></div></div>
        <article class="idea-box">
          <h3>{edition.oneIdea.title}</h3>
          <div><p>{edition.oneIdea.summary}</p><p><strong>Why now:</strong> {edition.oneIdea.whyNow}</p><div class="source-links">{edition.oneIdea.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></div>
        </article>
      </section>
      <section class="section" id="critical" aria-labelledby="critical-heading">
        <div class="section-title"><div><div class="flag">Front page · high impact</div><h2 id="critical-heading">Important &amp; critical</h2></div><p>What could change decisions, risk, or direction?</p></div>
        <div class="critical-grid">
          {critical.map((story, index) => <article class="story"><div class="publisher">No. {String(index + 1).padStart(2, '0')} · {story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><p class="why"><strong>Why it matters:</strong> {story.whyCare}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}
        </div>
      </section>
      {(launches.length > 0 || research.length > 0 || signals.length > 0 || briefs.length > 0) && <section class="section" id="newsroom" aria-labelledby="newsroom-heading">
        <div class="section-title"><div><div class="flag">More from the wire</div><h2 id="newsroom-heading">The newsroom</h2></div><p>Products, research, business, policy, and the signals worth a second look.</p></div>
        {launches.length > 0 && <div class="wire-desk"><h3>Launchpad</h3><div class="wire-grid">{launches.map((story) => <article class="wire-card"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}</div></div>}
        {research.length > 0 && <div class="wire-desk"><h3>Research &amp; benchmarks</h3><div class="wire-grid">{research.map((story) => <article class="wire-card"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}</div></div>}
        {signals.length > 0 && <div class="wire-desk"><h3>Markets, policy &amp; work</h3><div class="wire-grid">{signals.map((story) => <article class="wire-card"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}</div></div>}
        {briefs.length > 0 && <div class="wire-desk"><h3>Briefing wire</h3><div class="wire-grid compact">{briefs.map((story) => <article class="wire-card"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}</div></div>}
      </section>}
      <section class="section" aria-label={incidents.length ? 'AI Giggles and Incidents' : 'AI Giggles'}>
        <div class="desk" style={incidents.length ? undefined : 'grid-template-columns:1fr'}>
          <section class="desk-panel" id="giggles" aria-labelledby="giggles-heading">
            <div class="section-title"><div><div class="flag">The lighter side</div><h2 id="giggles-heading">AI Giggles</h2></div><p>Odd, amusing, and sourceable.</p></div>
            {giggles.length ? giggles.map((story) => <article class="story"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><p class="context"><strong>Why it’s funny (and relevant):</strong> {story.whyCare}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>) : <p class="empty">No verifiable giggle made today’s wire by this edition’s cutoff. We’ll keep the jokes in the headlines, not in the facts.</p>}
          </section>
          {incidents.length > 0 && <section class="desk-panel incidents" id="incidents" aria-labelledby="incidents-heading">
            <div class="section-title"><div><div class="flag">Failures · accidents · harmful actions</div><h2 id="incidents-heading">Incident desk</h2></div><p>What went wrong, and what is confirmed?</p></div>
            {incidents.map((story) => <article class="story"><div class="publisher">{story.status}{story.publisher ? ` · ${story.publisher}` : ''}</div><h3>{story.title}</h3><p>{story.summary}</p><p class="context"><strong>Impact / response:</strong> {story.whyCare}</p><div class="source-links">{story.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}
          </section>}
        </div>
      </section>
      <section class="section" id="insights" aria-labelledby="insights-heading">
        <div class="section-title"><div><div class="flag">Context → decision → next move</div><h2 id="insights-heading">Actionable insights</h2></div><p>Every item says why it matters and what to do next.</p></div>
        <div class="insights">
          {insights.map((item) => <article class="insight"><div class="insight-top"><span class="priority">{item.priority}</span><span class="label">Focus brief</span></div><h3>{item.title}</h3><p><strong>Context:</strong> {item.context}</p><p><strong>Why focus:</strong> {item.whyItMatters}</p><p><strong>Action:</strong> {item.action}</p>{item.watchFor && <p><strong>Watch for:</strong> {item.watchFor}</p>}<div class="source-links">{item.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div></article>)}
        </div>
      </section>
      <section class="section" id="shareables" aria-labelledby="shareables-heading">
        <div class="section-title"><div><div class="flag">Save it · send it · bring it to a meeting</div><h2 id="shareables-heading">Worth passing along</h2></div><p>Short, original takeaways with sources attached.</p></div>
        <div class="wire-grid share-cards">
          {takeaways.map((item) => <article class="wire-card"><h3>{item.title}</h3><p>{item.summary}</p><div class="source-links">{item.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div><button type="button" class="share-button" data-copy={`${item.title} — ${item.summary}`}>Copy takeaway</button></article>)}
        </div>
      </section>
            <section class="section" id="learn" aria-labelledby="learn-heading">
        <div class="section-title"><div><div class="flag">A concept from the news</div><h2 id="learn-heading">Understand one thing</h2></div></div>
        <article class="learning"><div><div class="label">Today’s concept</div><h3>{edition.learning.title}</h3></div><div><p>{edition.learning.body}</p><p class="try"><strong>Try this:</strong> {edition.learning.tryThis}</p></div></article>
      </section>
      <footer class="footer"><a href="/">← Portfolio</a></footer>
    </main>
      <script>
        document.querySelectorAll('.share-button').forEach((button) => {
          button.addEventListener('click', async () => {
            const original = button.textContent;
            try {
              await navigator.clipboard.writeText(button.dataset.copy ?? '');
              button.textContent = 'Copied';
            } catch {
              button.textContent = 'Copy unavailable';
            }
            window.setTimeout(() => { button.textContent = original; }, 1600);
          });
        });
      </script>
      </body>
</html>
